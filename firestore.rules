rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Herkese açık içerik: giriş yapmış kullanıcılar okuyabilir, yalnızca yönetici (Admin SDK) yazar.
    match /vehicles/{id}      { allow read: if request.auth != null; allow write: if false; }
    match /news/{id}          { allow read: if request.auth != null; allow write: if false; }
    match /notifications/{id} { allow read: if request.auth != null; allow write: if false; }

    // Kullanıcı yalnızca kendi profilini okuyup yazabilir.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
